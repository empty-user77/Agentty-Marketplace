{
  "id": "social-agentos",
  "name": "Social AgentOS",
  "version": "0.1.0",
  "publisher": "Agentty",
  "description": "Posting, run through agents you can watch: read what is being said, draft, read it yourself, then let the agent publish it in the browser you are already signed in to.",
  "icon": "sparkles",
  "runtime": "wasm",
  "main": "social-agentos.wasm",
  "apiVersion": 2,
  "contributes": {
    "commands": [{ "id": "social-agentos.open", "title": "Social AgentOS: open", "icon": "sparkles" }],
    "panel": { "title": "Social AgentOS", "icon": "sparkles", "surface": "sidebar", "mode": "push" }
  },
  "permissions": ["prompt.inject", "session.read", "workspace.read"],
  "keywords": ["agentos", "workflow", "social", "x", "instagram", "browser", "rust", "wasm"]
}
